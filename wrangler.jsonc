{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Custom Worker (ver custom-worker.ts): reexporta o fetch de
  // .open-next/worker.js e acrescenta o scheduled() do cron diário (item 13).
  "main": "custom-worker.ts",
  "name": "rosa-buffet",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rosa-buffet"
    }
  ],
  // Logs do Worker (Observability) ligados aqui no código: se forem ligados só
  // pelo painel, o próximo build (Workers Builds) desliga de novo.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "images": {
    "binding": "IMAGES"
  },
  // Resumo diário às 8h de Manaus (America/Manaus, UTC-4 fixo, sem horário
  // de verão) => 12h UTC.
  "triggers": {
    "crons": ["0 12 * * *", "*/15 * * * *"]
  }
}
